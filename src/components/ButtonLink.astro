---
interface Props {
  href: string;
  text: string;
  variant?: 'primary' | 'secondary';
  isDownload?: boolean;
  class?: string;
}

const { href, text, variant = 'primary', isDownload, class: className } = Astro.props;
const baseClass =
  'block w-[230px] rounded-full px-8 py-3.5 text-center text-base font-bold no-underline transition-all duration-300 ease-in-out shadow-lg hover:-translate-y-0.5';
const variantClass =
  variant === 'primary'
    ? 'bg-[var(--dark)] text-white shadow-slate-900/15 hover:bg-[var(--primary)] hover:shadow-[rgba(47,125,50,0.25)]'
    : 'border border-[var(--border)] bg-white text-[var(--primary)] shadow-[rgba(47,125,50,0.12)] hover:border-[var(--primary)] hover:bg-[var(--primary)] hover:text-white';
---

{
  isDownload && (
    <a
      href={href}
      download
      class={`${baseClass} ${variantClass} ${className ?? ''}`}
    >
      {text}
    </a>
  )
}

{
  !isDownload && (
    <a
      href={href}
      class={`${baseClass} ${variantClass} ${className ?? ''}`}
    >
      {text}
    </a>
  )
}
