---
interface Props {
  href: string;
  text: string;
  variant?: 'primary' | 'secondary';
  isDownload?: boolean;
  class?: string;
}

const { href, text, variant = 'primary', isDownload, class: className } = Astro.props;
const baseClass =
  'block w-[230px] rounded-full px-8 py-3.5 text-center text-base font-bold no-underline transition-all duration-300 ease-in-out hover:-translate-y-0.5';
const variantClass =
  variant === 'primary'
    ? 'bg-gradient-to-r from-[var(--primary)] to-[var(--primary-deep)] text-[#06121d] shadow-[0_10px_30px_-8px_var(--glow)] hover:shadow-[0_14px_44px_-6px_var(--glow)]'
    : 'border border-[var(--border)] bg-[var(--surface-2)] text-[var(--primary)] hover:border-[var(--border-strong)] hover:bg-[var(--surface-strong)] hover:text-white';
---

{
  isDownload && (
    <a
      href={href}
      download
      class={`${baseClass} ${variantClass} ${className ?? ''}`}
    >
      {text}
    </a>
  )
}

{
  !isDownload && (
    <a
      href={href}
      class={`${baseClass} ${variantClass} ${className ?? ''}`}
    >
      {text}
    </a>
  )
}
