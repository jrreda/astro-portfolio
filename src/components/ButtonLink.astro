---
interface Props {
  href: string;
  text: string;
  variant?: 'primary' | 'secondary';
  isDownload?: boolean;
}

const { href, text, variant = 'primary', isDownload } = Astro.props;
---

{
  isDownload && (
    <a
      href={href}
      download
      class={`px-8 py-3.5 block w-[230px] text-center no-underline text-lg transition-all duration-300 ease-in-out ${
        variant === 'primary'
          ? 'bg-[var(--primary)] text-white hover:bg-white hover:text-[var(--primary)] hover:border hover:border-[var(--primary)]'
          : 'bg-white text-[var(--primary)] border border-[var(--primary)] hover:bg-[var(--primary)] hover:text-white'
      }`}
    >
      {text}
    </a>
  )
}

{
  !isDownload && (
    <a
      href={href}
      class={`px-8 py-3.5 block w-[230px] text-center no-underline text-lg transition-all duration-300 ease-in-out ${
        variant === 'primary'
          ? 'bg-[var(--primary)] text-white hover:bg-white hover:text-[var(--primary)] hover:border hover:border-[var(--primary)]'
          : 'bg-white text-[var(--primary)] border border-[var(--primary)] hover:bg-[var(--primary)] hover:text-white'
      }`}
    >
      {text}
    </a>
  )
}
