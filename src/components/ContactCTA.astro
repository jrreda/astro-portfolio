---
import Section from './Section.astro';
import ButtonLink from './ButtonLink.astro';

const email = 'jrreda.dev@gmail.com';
---

<Section id="contact">
  <div class="text-center max-w-xl mx-auto">
    <h2 class="text-3xl font-bold mb-3 text-[var(--dark)]">
      Get in touch
    </h2>
    <p class="text-[var(--dark)] leading-7 mb-8">
      Have a project in mind or want to say hi? I'd love to hear from you.
    </p>
    <ButtonLink href={`mailto:${email}`} text="Contact me" class="mx-auto" />
  </div>
</Section>
