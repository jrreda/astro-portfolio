---
import Section from './Section.astro';
import SkillBadge from './SkillBadge.astro';
import experience from '../data/experience.json';

const heading = 'Experience';
---

<Section>
  <div class="mb-[60px]">
    <p class="eyebrow mb-3">Journey</p>
    <h2 class="m-0 text-[40px] font-black tracking-[-0.04em] max-[600px]:text-3xl">
      {heading}
    </h2>
  </div>

  <ol class="relative ml-3 list-none border-l border-[var(--border)] pl-8 max-[600px]:pl-6">
    {
      experience.map((job, index) => (
        <li
          class="relative pb-10 last:pb-0"
          data-reveal
          style={`--reveal-delay:${index * 90}ms`}
        >
          {/* timeline node */}
          <span
            aria-hidden="true"
            class="absolute -left-[41px] top-1.5 grid h-4 w-4 place-items-center rounded-full bg-[var(--bg)] ring-1 ring-[var(--border-strong)] max-[600px]:-left-[33px]"
          >
            <span class="h-2 w-2 rounded-full bg-[var(--primary)] shadow-[0_0_12px_2px_var(--glow)]" />
          </span>

          <div class="surface-card-soft rounded-[1.5rem] p-6 transition-all duration-300 hover:-translate-y-1 hover:border-[var(--border-strong)]">
            <div class="mb-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="text-xl font-black tracking-[-0.02em] text-[var(--text)]">
                {job.role}
              </h3>
              <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--primary)]">
                {job.period}
              </span>
            </div>
            <p class="mb-4 text-sm font-semibold text-[var(--text-muted)]">{job.company}</p>
            <p class="mb-5 leading-7 text-[var(--text-muted)]">{job.summary}</p>
            <div class="flex flex-wrap gap-2">
              {job.stack.map((tech) => (
                <SkillBadge skill={tech} />
              ))}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
