---
import { Image } from 'astro:assets';
import Section from './Section.astro';

const rightsText = 'Copyright © 2026 Reda - All rights reserved';

const socialMedia = [
  {
    src: '/images/icons/email.svg',
    alt: 'Email',
    href: 'mailto:jrreda.dev@gmail.com',
  },
  {
    src: '/images/icons/github.svg',
    alt: 'Github',
    href: 'https://github.com/jrreda_',
  },
  // { src: "/images/icons/x.svg", alt: "X", href: "https://x.com/jrreda_" },
  {
    src: '/images/icons/linkedin.svg',
    alt: 'Linkedin',
    href: 'https://linkedin.com/in/jrreda',
  },
];

const footerLinks = [
  { text: 'About', href: '/about' },
  { text: 'Projects', href: '/projects' },
  // { text: 'Blog', href: '/blog' },
  { text: 'Skills', href: '/skills' },
  { text: 'Now', href: '/now' },
  { text: 'Uses', href: '/uses' },
  { text: 'Contact', href: '/contact' },
];
---

<!-- wrap with section component -->
<Section dark>
  <footer class="flex flex-col items-center">
    <div class="flex gap-5 mb-6 items-center">
      {
        socialMedia.map((icon) => (
          <a href={icon.href} target="_blank" rel="noopener noreferrer">
            <Image
              src={icon.src}
              alt={icon.alt}
              width={32}
              height={32}
              class="max-[500px]:h-[22px] max-[500px]:w-[22px] hover:scale-110 transition-transform duration-200 cursor-pointer"
            />
          </a>
        ))
      }
    </div>

    <nav class="mb-6">
      <ul
        class="list-none flex flex-wrap gap-4 justify-center max-[500px]:gap-3"
      >
        {
          footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[var(--dark)] text-sm no-underline hover:text-[var(--primary)] transition-colors duration-200"
              >
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="text-[12px]">{rightsText}</p>
  </footer>
</Section>
