---
import Section from "./Section.astro";

const rightsText = "Copyright © 2025 Astra All rights reserved";
const creditText = "Images: Flaticon.com";

const socialMedia = [
  { src: "/images/icons/email.svg", alt: "Email", href: "mailto:ma7moudr3d4@gmail.com" },
  { src: "/images/icons/github.svg", alt: "Github", href: "https://github.com/jrreda_" },
  { src: "/images/icons/x.svg", alt: "X", href: "https://x.com/jrreda_" },
  { src: "/images/icons/linkedin.svg", alt: "Linkedin", href: "https://linkedin.com/in/jrreda" },
];
---

<!-- wrap with section component -->
<Section dark>
  <footer>
    <div class="icons-container">
      {socialMedia.map((icon) => (
        <a href={icon.href} target="_blank" rel="noopener noreferrer">
          <img src={icon.src} alt={icon.alt} />
        </a>
      ))}
    </div>
    <p class="rights-text">{rightsText}</p>
    <p class="credit-text">{creditText}</p>
  </footer>
</Section>

<style>
  footer {
    display: flex;
    align-items: center;
    flex-direction: column;

    .icons-container {
      display: flex;
      gap: 20px;
      margin-bottom: 20px;
      align-items: center;
    }

    .credit-text {
      color: var(--light);
      margin-top: 8px;
      font-size: 14px;
    }

    @media screen and (max-width: 500px) {
      .icons-container {
        flex-direction: column;
        gap: 4px;
        img {
          height: 20px;
        }
      }
    }
  }
</style>
