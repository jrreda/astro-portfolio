---
import { Image } from 'astro:assets';
import Section from './Section.astro';

const rightsText = 'Copyright © 2025 Astra All rights reserved';
const creditText = 'Images: Flaticon.com';

const socialMedia = [
  {
    src: '/images/icons/email.svg',
    alt: 'Email',
    href: 'mailto:ma7moudr3d4@gmail.com',
  },
  {
    src: '/images/icons/github.svg',
    alt: 'Github',
    href: 'https://github.com/jrreda_',
  },
  // { src: "/images/icons/x.svg", alt: "X", href: "https://x.com/jrreda_" },
  {
    src: '/images/icons/linkedin.svg',
    alt: 'Linkedin',
    href: 'https://linkedin.com/in/jrreda',
  },
];
---

<!-- wrap with section component -->
<Section dark>
  <footer class="flex items-center flex-col">
    <div class="flex gap-5 mb-5 items-center">
      {
        socialMedia.map((icon) => (
          <a href={icon.href} target="_blank" rel="noopener noreferrer">
            <Image
              src={icon.src}
              alt={icon.alt}
              width={32}
              height={32}
              class="max-[500px]:h-[22px] max-[500px]:w-[22px]"
            />
          </a>
        ))
      }
    </div>
    <p>{rightsText}</p>
    <p class="text-[var(--light)] mt-2 text-sm">{creditText}</p>
  </footer>
</Section>
