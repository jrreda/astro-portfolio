---
import { Image } from 'astro:assets';
import me from '/public/images/me.png';
import ButtonLink from './ButtonLink.astro';
import Container from './Container.astro';
---

<Container>
  <header
    class="grid grid-cols-[540px_1fr] justify-items-center gap-20 items-center my-20 max-[1000px]:grid-cols-1 max-[1000px]:grid-rows-auto max-[1000px]:gap-10"
  >
    <div>
      <h1 class="text-[44px] flex flex-col mb-5">
        Hi. I am Reda. <span class="text-[var(--primary)]">Full-stack</span> Developer!
      </h1>
      <p class="leading-7 text-[var(--dark)] mb-[30px]">
        I'm a Full-Stack Developer specializing in React.js, Next.js, Node.js,
        and database management. I build scalable, high-performance web
        applications, robust back-end architecture, and efficient API
        integrations.
      </p>
      <div class="flex gap-2.5 max-[600px]:flex-col">
        <ButtonLink href="/projects" text="View projects" variant="secondary" />
        <ButtonLink
          href="/resume.pdf"
          text="Download resume"
          isDownload={true}
        />
      </div>
    </div>
    <Image
      src={me}
      alt="Me"
      width={300}
      height={300}
      loading="eager"
      class="max-[1000px]:row-start-1"
    />
  </header>
</Container>
