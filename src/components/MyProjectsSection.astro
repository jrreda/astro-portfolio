---
import { Image } from "astro:assets";
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
import { getCollection } from "astro:content";

const heading = "My Projects";
const cta = { text: "View All", href: "/projects" };

const projects = await getCollection("project");
---

<Section dark>
  <SectionHeader heading={heading} cta={cta} />

  <div class="projects-container">
    {
      projects.map((project) => (
        <div class="card">
          <Image src={project.data.image} alt={project.data.title} width={300} height={250} />
          <h3>
            <a href={project.data.liveSiteURL}>{project.data.title}</a>
          </h3>
          {/* <p>{project.data.description}</p>
          <div class="cta-container">
            <a href={project.data.githubURL}>GitHub</a>
            <a href={project.data.liveSiteURL}>Live Site</a>
          </div> */}
        </div>
      ))
    }
  </div>
</Section>

<style>
  .projects-container {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px;

    .card {
      overflow: hidden;
      transition: transform 0.3s;
      display: flex;
      flex-direction: column;
    }

    h3 {
      margin-top: 20px;
    }

    a {
      text-decoration: none;
      color: var(--dark);
      font-weight: 600;
      font-size: 18px;
    }

    @media (max-width: 700px) {
      & {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
