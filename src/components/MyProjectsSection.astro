---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';
import { getCollection } from 'astro:content';
import SkillBadge from './SkillBadge.astro';

const heading = 'My Projects';
const cta = { text: 'View All', href: '/projects' };

const projects = await getCollection('project');
---

<Section dark>
  <SectionHeader heading={heading} cta={cta} />

  <div class="gap-6 grid grid-cols-3 max-[700px]:grid-cols-1 max-[900px]:grid-cols-2">
    {
      projects.map((project) => (
        <div class="group hover:shadow-2xl hover:shadow-slate-900/10 p-3 rounded-[1.75rem] overflow-hidden transition-all hover:-translate-y-1 duration-300 surface-card-soft">
          <div class="bg-[var(--secondary)] rounded-[1.2rem] overflow-hidden">
            <Image
              src={project.data.image}
              alt={project.data.title}
              width={360}
              height={260}
              class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-3">
          <h3 class="mt-3">
            {project.data.liveSiteURL ? (
              <a
                href={project.data.liveSiteURL}
                class="font-bold text-[var(--dark)] hover:text-[var(--primary)] text-xl no-underline transition-colors"
              >
                {project.data.title}
              </a>
            ) : (
              <span class="font-bold text-[var(--dark)] text-xl">{project.data.title}</span>
            )}
          </h3>
          <p class="my-3 font-medium text-[var(--muted)] text-sm leading-6">{project.data.description.slice(0, 82)}...</p>
          <div class="flex flex-wrap gap-2">
            {project.data.techStack.slice(0, 3).map((tech) => (
              <SkillBadge skill={tech} />
            ))}
          </div>
          </div>
        </div>
      ))
    }
  </div>
</Section>
