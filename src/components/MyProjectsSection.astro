---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';
import { getCollection } from 'astro:content';
import SkillBadge from './SkillBadge.astro';

const heading = 'My Projects';
const cta = { text: 'View All', href: '/projects' };

const projects = await getCollection('project');
---

<Section dark>
  <SectionHeader heading={heading} cta={cta} />

  <div class="grid grid-cols-3 gap-6 max-[700px]:grid-cols-1">
    {
      projects.map((project) => (
        <div class="overflow-hidden transition-transform duration-300 flex flex-col">
          <Image
            src={project.data.image}
            alt={project.data.title}
            width={300}
            height={250}
          />
          <h3 class="mt-5">
            <a
              href={project.data.liveSiteURL}
              class="no-underline text-[var(--dark)] font-semibold text-lg"
            >
              {project.data.title}
            </a>
          </h3>
          <p class="my-2 text-sm font-medium leading-tight">{project.data.description.slice(0, 30)}...</p>
          <div class="flex flex-wrap gap-2">
            {project.data.techStack.slice(0, 3).map((tech) => (
              <SkillBadge skill={tech} />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Section>
