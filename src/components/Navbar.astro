---
import Container from "./Container.astro";

const navItems = [
  { text: "About", href: "/about" },
  { text: "Projects", href: "/projects" },
  // { text: "Blog", href: "/blog" },
  { text: "Skills", href: "/skills" },
  { text: "Now", href: "/now" },
  { text: "Contact", href: "/#contact" },
];

const currentPath = Astro.url.pathname;
const activeClass =
  "text-[var(--primary)] bg-[var(--surface-strong)] border-[var(--border)]";
const hoverClass = "hover:text-[var(--primary)] hover:bg-[var(--surface-2)]";
---

<nav
  data-nav
  class="top-0 z-50 sticky bg-[var(--bg)]/70 backdrop-blur-xl border-b border-transparent transition-all duration-300 [&.scrolled]:border-[var(--border)] [&.scrolled]:bg-[var(--bg)]/85 [&.scrolled]:shadow-[0_8px_30px_rgba(0,0,0,0.4)]"
>
  <Container>
    <div
      class="flex max-[640px]:flex-col justify-between items-center max-[640px]:gap-4 py-4"
    >
      <div>
        <a href="/" class="group inline-flex items-center gap-2 font-bold text-lg">
          <span class="gradient-text">Reda.dev</span>
        </a>
      </div>
      <ul class="flex flex-wrap justify-center gap-2 list-none">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class={`rounded-full border border-transparent px-4 py-2 text-sm font-semibold transition-all duration-200 text-[var(--text-muted)] ${hoverClass}
                  ${currentPath === item.href ? activeClass : ""}`}
                aria-label={`Go to ${item.text} page`}
              >
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</nav>
