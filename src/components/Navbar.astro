---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import logo from '/public/images/ASTRA.svg';

const navItems = [
  { text: 'Projects', href: '/projects' },
  { text: 'Blog', href: '/blog' },
  { text: 'Contact', href: '/contact' },
];
---

<nav class="bg-[var(--secondary)]">
  <Container>
    <div
      class="flex py-6 justify-between items-center max-[500px]:flex-col max-[500px]:gap-4"
    >
      <div>
        <a href="/">
          <Image
            src={logo}
            alt="Logo"
            height={20}
            width={80}
            loading="eager"
            class="h-5"
          />
        </a>
      </div>
      <ul class="list-none flex gap-6">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="no-underline text-[var(--dark)] text-lg"
              >
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</nav>
