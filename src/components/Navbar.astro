---
import Container from "./Container.astro";

const navItems = [
  { text: "About", href: "/about" },
  { text: "Projects", href: "/projects" },
  // { text: "Blog", href: "/blog" },
  { text: "Skills", href: "/skills" },
  { text: "Now", href: "/now" },
  { text: "Contact", href: "/#contact" },
];

const currentPath = Astro.url.pathname;
const activeClass =
  "font-bold text-[var(--primary)] underline underline-offset-2";
const hoverClass = "font-bold hover:text-[var(--primary)]";
---

<nav class="bg-[var(--secondary)]">
  <Container>
    <div
      class="flex py-6 justify-between items-center max-[500px]:flex-col max-[500px]:gap-4"
    >
      <div>
        <a href="/" class="text-2xl font-bold text-[var(--primary)]">Home</a>
      </div>
      <ul class="list-none flex gap-6">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class={`text-lg transition-colors duration-200 text-[var(--dark)] ${hoverClass}
                  ${currentPath === item.href ? activeClass : ""}`}
                aria-label={`Go to ${item.text} page`}
              >
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</nav>
