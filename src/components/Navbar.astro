---
import Container from "./Container.astro";

const navItems = [
  { text: "About", href: "/about" },
  { text: "Projects", href: "/projects" },
  // { text: "Blog", href: "/blog" },
  { text: "Skills", href: "/skills" },
  { text: "Now", href: "/now" },
  { text: "Contact", href: "/#contact" },
];

const currentPath = Astro.url.pathname;
const activeClass =
  "text-[var(--primary)] bg-white shadow-sm";
const hoverClass = "hover:text-[var(--primary)] hover:bg-white/70";
---

<nav class="top-0 z-50 sticky bg-white/75 backdrop-blur-xl border-[var(--border)] border-b">
  <Container>
    <div
      class="flex max-[640px]:flex-col justify-between items-center max-[640px]:gap-4 py-4"
    >
      <div>
        <a href="/" class="group inline-flex items-center gap-2 font-bold text-lg">
          <span class="gradient-text">Reda.dev</span>
        </a>
      </div>
      <ul class="flex flex-wrap justify-center gap-2 list-none">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class={`rounded-full px-4 py-2 text-sm font-semibold transition-all duration-200 text-[var(--dark)] ${hoverClass}
                  ${currentPath === item.href ? activeClass : ""}`}
                aria-label={`Go to ${item.text} page`}
              >
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</nav>
