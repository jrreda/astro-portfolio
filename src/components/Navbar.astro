---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import logo from '/public/images/ASTRA.svg';

const navItems = [
  { text: 'About', href: '/about' },
  { text: 'Projects', href: '/projects' },
  { text: 'Blog', href: '/blog' },
  { text: 'Skills', href: '/skills' },
  { text: 'Now', href: '/now' },
  { text: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
const activeClass = 'font-bold text-[var(--primary)] underline underline-offset-2';
const hoverClass = 'font-bold hover:text-[var(--primary)]';
---

<nav class="bg-[var(--secondary)]">
  <Container>
    <div
      class="flex py-6 justify-between items-center max-[500px]:flex-col max-[500px]:gap-4"
    >
      <div>
        <a href="/">
          <Image
            src={logo}
            alt="Logo"
            height={20}
            width={80}
            loading="eager"
            class="h-5"
          />
        </a>
      </div>
      <ul class="list-none flex gap-6">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class={`text-lg transition-colors duration-200 text-[var(--dark)] ${hoverClass}
                  ${currentPath === item.href ? activeClass : ''}`}
                aria-label={`Go to ${item.text} page`}
              >
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</nav>
