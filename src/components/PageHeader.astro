---
interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<header class="mb-12 max-w-3xl">
  <p class="eyebrow mb-4">Portfolio</p>
  <h1 class="text-5xl font-black tracking-[-0.05em] text-[var(--dark)] max-[600px]:text-4xl">
    <span class="gradient-text">{heading}</span>
  </h1>
  {Astro.slots.has('subtitle') && (
    <p class="text-[var(--muted)] mb-8 text-base leading-7 mt-5">
      <slot name="subtitle" />
    </p>
  )}
</header>

