---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ButtonLink from './ButtonLink.astro';

interface Props {
  project: CollectionEntry<'project'>;
  loading?: 'eager' | 'lazy';
}

const { project, loading = 'lazy' } = Astro.props;
---

<div class="overflow-hidden flex gap-10 max-[800px]:flex-col">
  <Image
    src={project.data.image}
    alt={project.data.title}
    width={200}
    height={200}
    loading={loading}
    class="h-[200px] w-[200px] object-cover max-[800px]:self-center"
  />

  <div>
    <h3 class="text-[30px] font-semibold mb-5">{project.data.title}</h3>
    <p class="mb-10">{project.data.description}</p>
    <div class="flex gap-2.5 mt-2.5 max-[600px]:flex-col">
      {project.data.githubURL && (
        <ButtonLink
          href={`${project.data.githubURL}`}
          text="View on Github"
          variant="secondary"
        />
      )}
      {project.data.liveSiteURL && (
        <ButtonLink href={`${project.data.liveSiteURL}`} text="View Live" />
      )}
    </div>
  </div>
</div>
