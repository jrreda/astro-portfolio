---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ButtonLink from './ButtonLink.astro';
import SkillBadge from './SkillBadge.astro';

interface Props {
  project: CollectionEntry<'project'>;
  loading?: 'eager' | 'lazy';
}

const { project, loading = 'lazy' } = Astro.props;
---

<div class="surface-card-soft group flex gap-8 overflow-hidden rounded-[2rem] p-5 transition-all duration-300 hover:-translate-y-1 hover:border-[var(--border-strong)] hover:shadow-2xl hover:shadow-black/30 max-[800px]:flex-col">
  <div class="overflow-hidden rounded-[1.5rem] bg-[var(--surface-2)] max-[800px]:self-center">
    <Image
      src={project.data.image}
      alt={project.data.title}
      width={240}
      height={220}
      loading={loading}
      class="h-[220px] w-[240px] object-cover transition-transform duration-500 group-hover:scale-105 max-[800px]:w-full"
    />
  </div>

  <div class="py-2">
    <h3 class="text-[30px] font-black tracking-[-0.03em] mb-4">{project.data.title}</h3>
    <p class="mb-6 leading-7 text-[var(--muted)]">{project.data.description}</p>

    {project.data.techStack && project.data.techStack.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-6">
        {project.data.techStack.map((tech) => (
          <SkillBadge skill={tech} />
        ))}
      </div>
    )}

    <div class="flex gap-2.5 mt-2.5 max-[600px]:flex-col">
      {project.data.githubURL && (
        <ButtonLink
          href={`${project.data.githubURL}`}
          text="View on Github"
          variant="secondary"
        />
      )}
      {project.data.liveSiteURL && (
        <ButtonLink href={`${project.data.liveSiteURL}`} text="View Live" />
      )}
    </div>
  </div>
</div>
