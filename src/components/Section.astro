---
import Container from './Container.astro';

interface Props {
  dark?: boolean;
  id?: string;
  reveal?: boolean;
}

const { dark = false, id, reveal = true } = Astro.props;
---

<section
  id={id}
  class={`py-24 max-[1000px]:py-12 ${dark ? 'border-y border-[var(--border)] bg-white/[0.015]' : ''}`}
  data-reveal={reveal ? '' : undefined}
>
  <Container>
    <slot />
  </Container>
</section>
