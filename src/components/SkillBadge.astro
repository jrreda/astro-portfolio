---
import { Image } from 'astro:assets';
import skillIcons from '../data/skill-icons.json';
interface Props {
  skill: string;
}

const { skill } = Astro.props;
const iconId = skillIcons[skill] || null;
---

<div
  class="flex items-center gap-2 px-3 py-2 rounded-lg bg-[var(--secondary)] hover:bg-[var(--primary)] transition-colors duration-200 group cursor-default"
  title={skill}
>
  {iconId && (
    <Image
      src={`https://cdn.simpleicons.org/${iconId}`}
      alt={skill}
      width={20}
      height={20}
      class="group-hover:brightness-0 group-hover:invert transition-all duration-200"
    />
  )}
  <span class="text-sm font-medium text-[var(--dark)] group-hover:text-white transition-colors duration-200">
    {skill}
  </span>
</div>

