---
import { Image } from 'astro:assets';
import skillIcons from '../data/skill-icons.json';
interface Props {
  skill: string;
}

const { skill } = Astro.props;
const iconId = skillIcons[skill] || null;
---

<div
  class="group/badge flex cursor-default items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface-2)] px-3.5 py-2 transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--border-strong)] hover:bg-[var(--surface-strong)]"
  title={skill}
>
  {iconId && (
    <Image
      src={`https://cdn.simpleicons.org/${iconId}`}
      alt={skill}
      width={20}
      height={20}
      class="opacity-90 transition-opacity duration-200 group-hover/badge:opacity-100"
    />
  )}
  <span class="text-sm font-semibold text-[var(--text)] transition-colors duration-200 group-hover/badge:text-white">
    {skill}
  </span>
</div>

