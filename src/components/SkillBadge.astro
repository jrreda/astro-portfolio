---
import { Image } from 'astro:assets';
import skillIcons from '../data/skill-icons.json';
interface Props {
  skill: string;
}

const { skill } = Astro.props;
const iconId = skillIcons[skill] || null;
---

<div
  class="group/badge flex cursor-default items-center gap-2 rounded-full border border-[var(--border)] bg-white/80 px-3.5 py-2 shadow-sm shadow-slate-900/5 transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--primary)] hover:bg-[var(--dark)]"
  title={skill}
>
  {iconId && (
    <Image
      src={`https://cdn.simpleicons.org/${iconId}`}
      alt={skill}
      width={20}
      height={20}
      class="transition-all duration-200 group-hover/badge:brightness-0 group-hover/badge:invert"
    />
  )}
  <span class="text-sm font-semibold text-[var(--dark)] transition-colors duration-200 group-hover/badge:text-white">
    {skill}
  </span>
</div>

