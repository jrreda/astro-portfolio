---
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';
import SkillBadge from './SkillBadge.astro';
import skillsData from '../data/skills.json';

const heading = 'Skills & Tools';
const cta = { text: 'View All', href: '/skills' };

// Get categories for preview (show first 3 most relevant categories)
// Prioritize: Frontend, Backend, Languages, or Tools
const priorityCategories = [
  'Frontend',
  'Backend',
  'Languages',
  'Tools',
  'Frameworks',
];
const allCategories = Object.keys(skillsData);
const categories = priorityCategories
  .filter((cat) => allCategories.includes(cat))
  .slice(0, 3);
---

<Section>
  <SectionHeader heading={heading} cta={cta} />

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {
      categories.map((category) => (
        <div class="surface-card-soft rounded-[1.75rem] p-6">
          <h3 class="text-xl font-black tracking-[-0.03em] mb-4 text-[var(--dark)]">
            {category}
          </h3>
          <div class="flex flex-wrap gap-3">
            {skillsData[category].slice(0, 6).map((skill) => (
              <SkillBadge skill={skill} />
            ))}
            {skillsData[category].length > 6 && (
              <div
                class="flex items-center gap-2 rounded-full border border-dashed border-[var(--border)] bg-[var(--surface)] px-3 py-2 text-sm font-semibold text-[var(--text-muted)]"
              >
                +{skillsData[category].length - 6} more
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</Section>
