---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const pageTitle = `Blog - ${post.data.title}`;
---

<Layout title={pageTitle}>
  <Section>
    <div>
      <Image
        src={post.data.image}
        alt={post.data.title}
        class="w-full object-cover mb-10 rounded-[10px]"
        width={800}
        height={550}
        loading="eager"
      />
      <h1 class="mb-4">{post.data.title}</h1>
      <p class="text-xl text-[var(--text-muted)] mb-[30px]">{post.data.date}</p>
      <div
        class="leading-8 text-[var(--text-muted)] [&_a]:text-[var(--primary)] [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mb-5 [&_h2]:mt-[30px] [&_h2]:text-[var(--text)] [&_h2]:font-black [&_li]:my-1 [&_strong]:text-[var(--text)] [&_ul]:list-disc [&_ul]:pl-6"
      >
        <Content />
      </div>
    </div>
  </Section>
</Layout>
