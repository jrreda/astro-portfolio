---
import Section from "../components/Section.astro";
import Layout from "../layouts/Layout.astro";
import me from "/public/images/me.png";

const title = "Contact";
const email = "me@jamesqquick.com";
---

<Layout title="Contact">
  <Section>
    <h1>{title}</h1>
    <p>You can contact me at <a href={`mailto:${email}`}>{email}.</a></p>
    <img src={me.src} alt="My photo" />
  </Section>
</Layout>
