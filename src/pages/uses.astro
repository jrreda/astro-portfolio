---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';

const heading = 'Uses';
const pageTitle = 'Uses - Tools & Setup - Reda';
---

<Layout title={pageTitle}>
  <Section>
    <PageHeader heading={heading}>
      <span slot="subtitle">
        A list of tools, software, and hardware I use in my daily work and life. Last
        updated: <time
          class="text-[var(--primary)]"
          datetime="2025-12-04">December 4, 2025</time>
      </span>
    </PageHeader>

    <div class="space-y-8">
      <section>
        <h2 class="text-2xl mb-4 text-[var(--primary)]">Development Tools</h2>
        <ul class="list-none space-y-3 text-[var(--dark)] leading-7">
          <li>
            <strong>Editor:</strong> Cursor (AI-powered code editor)
          </li>
          <li>
            <strong>Terminal:</strong> Warp
          </li>
          <li>
            <strong>Version Control:</strong> Git with GitHub & GitLab
          </li>
          <li>
            <strong>Package Manager:</strong> pnpm, npm
          </li>
          <li>
            <strong>API Testing:</strong> Postman
          </li>
          <li>
            <strong>Database Tools:</strong> TablePlus, MySQL Workbench, phpMyAdmin
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl mb-4 text-[var(--primary)]">Design & Productivity</h2>
        <ul class="list-none space-y-3 text-[var(--dark)] leading-7">
          <li>
            <strong>Design:</strong> Figma, Adobe XD
          </li>
          <li>
            <strong>Note Taking:</strong> Notion, Obsidian, Google Keep
          </li>
          <li>
            <strong>Task Management:</strong> Jira, GitHub Projects
          </li>
          <li>
            <strong>Communication:</strong> Slack
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl mb-4 text-[var(--primary)]">Development Stack</h2>
        <ul class="list-none space-y-3 text-[var(--dark)] leading-7">
          <li>
            <strong>Frontend:</strong> React, Next.js, Astro, Vue.js, TypeScript
          </li>
          <li>
            <strong>Styling:</strong> Tailwind CSS, shadcn/ui, Styled Components, CSS Modules
          </li>
          <li>
            <strong>Backend:</strong> Node.js, Express, Laravel, Django
          </li>
          <li>
            <strong>Databases:</strong> PostgreSQL, MySQL, MongoDB, Redis, Supabase
          </li>
          <li>
            <strong>Deployment:</strong> Vercel, Netlify, Docker
          </li>
          <li>
            <strong>CI/CD:</strong> GitHub Actions
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl mb-4 text-[var(--primary)]">Hardware</h2>
        <ul class="list-none space-y-3 text-[var(--dark)] leading-7">
          <li>
            <strong>Computer:</strong> MacBook Pro (M1)
          </li>
          <li>
            <strong>Monitor:</strong> External monitor for extended workspace (27 inch)
          </li>
          <li>
            <strong>Keyboard:</strong> Apple Magic Keyboard
          </li>
          <li>
            <strong>Mouse:</strong> Logitech MX Master 3
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl mb-4 text-[var(--primary)]">Browser & Extensions</h2>
        <ul class="list-none space-y-3 text-[var(--dark)] leading-7">
          <li>
            <strong>Browser:</strong> Chrome, Firefox, Zen Browser
          </li>
          <li>
            <strong>Extensions:</strong> React DevTools, Vue DevTools, Lighthouse,
            ColorZilla, JSON Formatter, CORS Unblocker
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl mb-4 text-[var(--primary)]">Services & Platforms</h2>
        <ul class="list-none space-y-3 text-[var(--dark)] leading-7">
          <li>
            <strong>Hosting:</strong> Vercel, Netlify
          </li>
          <li>
            <strong>Cloud:</strong> AWS, Firebase, Supabase
          </li>
          <li>
            <strong>Analytics:</strong> Google Analytics, Vercel Analytics
          </li>
          <li>
            <strong>Email:</strong> Gmail
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl mb-4 text-[var(--primary)]">Learning & Resources</h2>
        <ul class="list-none space-y-3 text-[var(--dark)] leading-7">
          <li>
            <strong>Documentation:</strong> MDN, official framework docs, Stack Overflow
          </li>
          <li>
            <strong>Courses:</strong> Scrimba, freeCodeCamp, Udemy, Laracasts
          </li>
          <li>
            <strong>Communities:</strong> Reddit, Dev.to, LinkedIn
          </li>
        </ul>
      </section>
    </div>

    <div class="mt-12 pt-8 border-t border-[var(--light)]">
      <p class="text-sm text-[var(--dark)] italic">
        Inspired by{' '}
        <a
          href="https://uses.tech"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--primary)] underline hover:text-[var(--dark)] transition-colors duration-200"
        >
          uses.tech
        </a>
      </p>
    </div>
  </Section>
</Layout>

