---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';

const heading = 'Uses';
const pageTitle = 'Uses - Tools & Setup - Reda';

const toolSections = [
  {
    title: 'Development Tools',
    summary: 'The daily workflow for coding, debugging, version control, and APIs.',
    items: [
      ['Editor', 'Cursor (AI-powered code editor)'],
      ['Terminal', 'Warp'],
      ['Version Control', 'Git with GitHub & GitLab'],
      ['Package Manager', 'pnpm, npm'],
      ['API Testing', 'Postman'],
      ['Database Tools', 'TablePlus, MySQL Workbench, phpMyAdmin'],
    ],
  },
  {
    title: 'Design & Productivity',
    summary: 'Tools that help me shape ideas, collaborate, and keep projects moving.',
    items: [
      ['Design', 'Figma, Adobe XD'],
      ['Note Taking', 'Notion, Obsidian, Google Keep'],
      ['Task Management', 'Jira, GitHub Projects'],
      ['Communication', 'Slack'],
    ],
  },
  {
    title: 'Development Stack',
    summary: 'The technologies I reach for when building modern product interfaces.',
    items: [
      ['Frontend', 'React, Next.js, Astro, Vue.js, TypeScript'],
      ['Styling', 'Tailwind CSS, shadcn/ui, Styled Components, CSS Modules'],
      ['Backend', 'Node.js, Express, Laravel, Django'],
      ['Databases', 'PostgreSQL, MySQL, MongoDB, Redis, Supabase'],
      ['Deployment', 'Vercel, Netlify, Docker'],
      ['CI/CD', 'GitHub Actions, GitLab CI/CD'],
    ],
  },
  {
    title: 'Hardware',
    summary: 'A compact setup for focused frontend work and testing across screens.',
    items: [
      ['Computer', 'MacBook Pro (M1 Pro)'],
      ['Monitor', 'External monitor for extended workspace (27 inch)'],
      ['Keyboard', 'Apple Magic Keyboard'],
      ['Mouse', 'Logitech G502 Hero'],
    ],
  },
  {
    title: 'Browser & Extensions',
    summary: 'The inspection and quality tools I use to refine UI behavior.',
    items: [
      ['Browser', 'Chrome, Firefox, Zen Browser'],
      ['Extensions', 'React DevTools, Vue DevTools, Lighthouse, ColorZilla, JSON Formatter, CORS Unblocker'],
    ],
  },
  {
    title: 'Services & Platforms',
    summary: 'Hosted services for shipping, analytics, cloud features, and email.',
    items: [
      ['Hosting', 'Vercel, Netlify'],
      ['Cloud', 'AWS, Firebase, Supabase'],
      ['Analytics', 'Google Analytics, Vercel Analytics'],
      ['Email', 'Gmail'],
    ],
  },
  {
    title: 'Learning & Resources',
    summary: 'Reference material and learning loops that keep the craft sharp.',
    items: [
      ['Documentation', 'MDN, official framework docs, Stack Overflow'],
      ['Courses', 'Scrimba, freeCodeCamp, Udemy, Laracasts, Frontend Mentor'],
      ['Communities', 'Reddit, LinkedIn'],
    ],
  },
];
---

<Layout title={pageTitle}>
  <Section>
    <PageHeader heading={heading}>
      <span slot="subtitle">
        A list of tools, software, and hardware I use in my daily work and life. Last
        updated: <time
          class="text-[var(--primary)]"
          datetime="2026-02-13">February 13, 2026</time>
      </span>
    </PageHeader>

    <div class="gap-6 grid grid-cols-1 lg:grid-cols-2">
      {
        toolSections.map((section, index) => (
          <section class={`surface-card-soft rounded-[1.75rem] p-6 ${index === 2 ? 'lg:col-span-2' : ''}`}>
            <div class="flex justify-between items-start gap-4 mb-6">
              <div>
                <p class="mb-2 font-black text-[var(--primary)] text-xs uppercase tracking-[0.22em]">
                  Setup {String(index + 1).padStart(2, '0')}
                </p>
                <h2 class="font-black text-[var(--dark)] text-2xl tracking-[-0.03em]">
                  {section.title}
                </h2>
              </div>
              <span class="bg-[var(--surface-2)] px-3 py-1 border border-[var(--border)] rounded-full font-bold text-[var(--text-muted)] text-xs">
                {section.items.length} tools
              </span>
            </div>
            <p class="mb-6 text-[var(--muted)] leading-7">{section.summary}</p>
            <ul class="gap-3 grid md:grid-cols-2 list-none">
              {section.items.map(([label, value]) => (
                <li class="bg-[var(--surface)] p-4 border border-[var(--border)] rounded-2xl">
                  <strong class="block mb-1 text-[var(--text)] text-sm">{label}</strong>
                  <span class="text-[var(--text-muted)] text-sm leading-6">{value}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <div class="mt-12 p-6 rounded-[1.5rem] surface-card-soft">
      <p class="text-[var(--muted)] text-sm">
        Inspired by{' '}
        <a
          href="https://uses.tech"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-[var(--primary)] hover:text-[var(--dark)] decoration-[var(--accent)] underline underline-offset-4 transition-colors duration-200"
        >
          uses.tech
        </a>
      </p>
    </div>
  </Section>
</Layout>

